APP_ENV=local
LOGGER_LEVEL=debug
LOGGER_AS_JSON=false

HTTP_HOST=0.0.0.0
HTTP_PORT=8084

AUTH_USERNAME=local-user
AUTH_PASSWORD=local-auth-password

POSTGRES_USER=url_shortener
POSTGRES_PASSWORD=local-db-password
POSTGRES_DB=url_shortener
POSTGRES_PORT=5432
POSTGRES_DSN=postgres://url_shortener:local-db-password@postgres:5432/url_shortener?sslmode=disable

MIGRATIONS_DIR=/app/migrations
AUTO_MIGRATE=true
